<Window x:Class="Numbering.Revit.NumberingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нумерация элементов" Width="960" Height="660" MinWidth="720" MinHeight="490"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding DocumentTitle}" FontSize="20" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsApplying}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,12,9">
                <Label Content="_Категория" Target="{Binding ElementName=Category}" Padding="0,0,0,4"/>
                <ComboBox x:Name="Category" ItemsSource="{Binding Categories}" DisplayMemberPath="Label"
                          SelectedItem="{Binding Category}" MinHeight="27"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,9">
                <Label Content="_Охват" Target="{Binding ElementName=Scope}" Padding="0,0,0,4"/>
                <ComboBox x:Name="Scope" SelectedIndex="{Binding ScopeIndex}" MinHeight="27">
                    <ComboBoxItem Content="Видимые в таблице"/>
                    <ComboBoxItem Content="Выбранные в модели"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,0,9">
                <Label Content="П_оиск" Target="{Binding ElementName=Search}" Padding="0,0,0,4"/>
                <TextBox x:Name="Search" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         Padding="5,3" MinHeight="27"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,12,9">
                <Label Content="_Префикс" Target="{Binding ElementName=Prefix}" Padding="0,0,0,4"/>
                <TextBox x:Name="Prefix" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                         Padding="5,3" MinHeight="27"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,9">
                <Label Content="_Шаблон номера" Target="{Binding ElementName=Pattern}" Padding="0,0,0,4"/>
                <TextBox x:Name="Pattern" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Подстановки: {Префикс}, {Уровень}, {N:000}" Padding="5,3" MinHeight="27"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding TemplateError}" Foreground="#9D281F"
                   TextWrapping="Wrap" Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TemplateError}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Expander x:Name="PreviewConflictsPanel" Grid.Row="3" Margin="0,0,0,8">
            <Expander.Header>
                <TextBlock Text="{Binding PreviewConflicts.Count, StringFormat='Конфликты предпросмотра ({0})'}"/>
            </Expander.Header>
            <Expander.Style>
                <Style TargetType="Expander">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PreviewConflicts.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <ListBox x:Name="PreviewConflictsList" ItemsSource="{Binding PreviewConflicts}" MaxHeight="118"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>
        <DataGrid Grid.Row="4" ItemsSource="{Binding VisibleRows}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                  RowHeaderWidth="0" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F2F6FA"
                  BorderBrush="#CDD7E3" Background="White">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Status}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasIssue}" Value="True">
                            <Setter Property="Foreground" Value="#9D281F"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ElementId" Binding="{Binding Element.Id}" Width="80"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Element.Name}" Width="1.4*"/>
                <DataGridTextColumn Header="Уровень" Binding="{Binding Element.Level}" Width="*"/>
                <DataGridTextColumn Header="Текущее значение" Binding="{Binding Element.CurrentValue}" Width="*"/>
                <DataGridTextColumn Header="Новое значение" Binding="{Binding Proposal.Value}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="1.6*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                <ProgressBar Value="{Binding ApplyProgress, Mode=OneWay}" Height="6" Margin="0,5,0,0"
                             AutomationProperties.Name="Прогресс записи номеров">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApplying}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ApplyProgress}" Value="-1">
                                    <Setter Property="IsIndeterminate" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
            <Button Grid.Column="1" Content="_Применить" Command="{Binding ApplyCommand}"
                    Padding="16,4" MinWidth="120" MinHeight="30"/>
        </Grid>
        <Expander Grid.Row="6" Header="{Binding ReportTitle}" Margin="0,10,0,0">
            <Expander.Style>
                <Style TargetType="Expander">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ReportTitle}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <TextBox Text="{Binding ReportDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="130" Padding="6" VerticalScrollBarVisibility="Auto"/>
        </Expander>
    </Grid>
</Window>
